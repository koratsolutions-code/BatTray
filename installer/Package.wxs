<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    UpgradeCode must never change: it is how new versions replace old ones.
    Scope="perUser": no administrator rights; files go to %LocalAppData%\Programs\BatTray.
  -->
  <Package Name="BatTray"
           Manufacturer="Korat Solutions"
           Version="$(var.ProductVersion)"
           UpgradeCode="7E3B6C1A-9F2D-4A57-8C1E-4B2D6F0A9C31"
           Scope="perUser"
           Compressed="yes">

    <SummaryInformation Description="BatTray — battery levels of your wireless peripherals on the Windows taskbar" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of BatTray is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="BatTrayIcon" SourceFile="..\src\BatTray.App\Assets\BatTray.ico" />
    <Property Id="ARPPRODUCTICON" Value="BatTrayIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/koratsolutions-code/BatTray" />

    <!-- Branded wizard: welcome + license, progress, finish with "Launch BatTray" (art from tools/generate-installer-art.py). -->
    <ui:WixUI Id="WixUI_Minimal" /> <!-- also sets ARPNOMODIFY: no "Modify" in Settings > Apps -->
    <WixVariable Id="WixUILicenseRtf" Value="assets\License.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="assets\Dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="assets\Banner.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch BatTray" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchBatTray"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!-- %LocalAppData%\Programs\BatTray: the standard per-user location (no admin rights needed). -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="BatTray" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="BatTray">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="D2A4C6E8-1B3D-4F5A-9C7E-2A4B6C8D0E1F">
      <Shortcut Id="BatTrayShortcut"
                Name="BatTray"
                Description="Battery levels of your wireless peripherals on the taskbar"
                Target="[INSTALLFOLDER]BatTray.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="BatTrayIcon" />
      <Shortcut Id="UserGuideShortcut"
                Name="BatTray User Guide"
                Description="How to use BatTray and the devices it supports"
                Target="[INSTALLFOLDER]UserGuide.html"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\KoratSolutions\BatTray" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <!-- Start BatTray when the installation finishes: from the finish dialog's check box, or directly in quiet/basic installs. -->
    <CustomAction Id="LaunchBatTray" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]BatTray.exe&quot;" Return="asyncNoWait" Execute="immediate" />

    <!--
      Before installing, upgrading or removing: ask a running BatTray to close (it answers WM_CLOSE on its hidden
      "BatTray" window since 1.1), and end it if it is still running after the wait (1.0 has no such window).
      Without this the old version kept running and its files were only replaced after a reboot.
    -->
    <util:CloseApplication Id="CloseBatTray" Target="BatTray.exe" CloseMessage="yes" RebootPrompt="no" TerminateProcess="0" />

    <!-- On uninstall: close BatTray and remove its "start with Windows" entry. -->
    <CustomAction Id="CleanupBatTray" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]BatTray.exe&quot; --uninstall-cleanup" Return="ignore" Execute="immediate" />

    <InstallExecuteSequence>
      <Custom Action="CleanupBatTray" Before="InstallValidate" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="LaunchBatTray" After="InstallFinalize" Condition="NOT Installed AND NOT REMOVE AND UILevel &lt; 5" />
    </InstallExecuteSequence>
  </Package>
</Wix>
