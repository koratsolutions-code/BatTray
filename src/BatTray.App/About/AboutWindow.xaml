<Window x:Class="BatTray.App.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BatTray.App.Localization"
        Style="{StaticResource ThemedWindow}"
        Title="{x:Static loc:L.About}"
        Icon="/Assets/BatTray.ico"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">

    <StackPanel Width="420">
        <!-- Product -->
        <StackPanel Margin="28,28,28,20" Orientation="Horizontal">
            <Image Source="/Assets/BatTray-512.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="BatTray" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:L.Tagline}" FontSize="13" Foreground="{DynamicResource App.Accent}" />
                <TextBlock x:Name="VersionText" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource App.Muted}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="28,0,28,16" TextWrapping="Wrap" Foreground="{DynamicResource App.TextSecondary}"
                   Text="{x:Static loc:L.AboutDescription}" />

        <StackPanel Margin="28,0,28,22">
            <TextBlock Margin="0,0,0,6">
                <Hyperlink x:Name="GuideLink" Click="OnGuideClick"><Run Text="{x:Static loc:L.UserGuide}" /></Hyperlink>
            </TextBlock>
            <TextBlock>
                <Hyperlink x:Name="RepositoryLink" Click="OnRepositoryClick"><Run Text="{x:Static loc:L.WebsiteAndSource}" /></Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,6,0,0">
                <Hyperlink x:Name="LicenseLink" Click="OnLicenseClick"><Run Text="{x:Static loc:L.License}" /></Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- Maker -->
        <Border Style="{StaticResource DialogFooter}" Padding="28,18">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{x:Static loc:L.Close}" MinWidth="84" VerticalAlignment="Center"
                        IsDefault="True" IsCancel="True" Click="OnCloseClick" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Static loc:L.MadeBy}" FontSize="11" Foreground="{DynamicResource App.Muted}" Margin="0,0,0,4" />
                    <Image Source="{DynamicResource App.KoratLogo}" Height="40" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="CopyrightText" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource App.Muted}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
