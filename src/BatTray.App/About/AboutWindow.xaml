<Window x:Class="BatTray.App.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About BatTray"
        Icon="/Assets/BatTray.ico"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="#FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="#16284C">

    <Window.Resources>
        <Style x:Key="Link" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#2E6FD0" />
            <Setter Property="TextDecorations" Value="None" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Width="400">
        <!-- Product -->
        <StackPanel Margin="28,28,28,20" Orientation="Horizontal">
            <Image Source="/Assets/BatTray-512.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="BatTray" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Your devices. One glance." FontSize="13" Foreground="#2E6FD0" />
                <TextBlock x:Name="VersionText" Margin="0,6,0,0" FontSize="12" Foreground="#5A6B85" Text="Version" />
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="28,0,28,16" TextWrapping="Wrap" Foreground="#3A4A66"
                   Text="Battery levels of your wireless mice, keyboards, headsets and controllers, right on the Windows taskbar." />

        <StackPanel Margin="28,0,28,22">
            <TextBlock>
                <Hyperlink x:Name="RepositoryLink" Style="{StaticResource Link}" Click="OnRepositoryClick">Website and source code</Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,6,0,0">
                <Hyperlink x:Name="LicenseLink" Style="{StaticResource Link}" Click="OnLicenseClick">MIT License</Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- Maker -->
        <Border Background="#F5F8FC" BorderBrush="#E3E9F2" BorderThickness="0,1,0,0" Padding="28,18">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" MinWidth="84" Padding="12,5" VerticalAlignment="Center"
                        IsDefault="True" IsCancel="True" Click="OnCloseClick" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Made by" FontSize="11" Foreground="#5A6B85" Margin="0,0,0,4" />
                    <Image Source="/Assets/KoratLogo.png" Height="40" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="CopyrightText" Margin="0,6,0,0" FontSize="11" Foreground="#5A6B85" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
