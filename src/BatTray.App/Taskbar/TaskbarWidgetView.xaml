<UserControl x:Class="BatTray.App.Taskbar.TaskbarWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BatTray.App.ViewModels"
             xmlns:models="clr-namespace:BatTray.Core.Models;assembly=BatTray.Core"
             xmlns:core="clr-namespace:BatTray.Core;assembly=BatTray.Core"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!--
        Nearly transparent background (alpha 1) instead of Transparent: in a per-pixel transparent window,
        pixels with alpha 0 do not receive mouse input, and we want tooltips and right-click on the whole widget.
    -->
    <!-- The context menu is assigned in code (shared with the tray icon). -->
    <Grid Background="#01000000">

        <ItemsControl ItemsSource="{Binding Devices}" VerticalAlignment="Center" Margin="2,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Visibility"
                            Value="{Binding IsShown, Converter={StaticResource BoolToVisibility}}" />
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                    <StackPanel Orientation="Horizontal" Margin="5,0" Background="#01000000"
                                ToolTip="{Binding ToolTip}">
                        <Image x:Name="IconImage" Width="16" Height="16" VerticalAlignment="Center" Visibility="Collapsed"
                               Source="{Binding Icon.Image}" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Path x:Name="Icon"
                              Width="16" Height="16" Stretch="None"
                              VerticalAlignment="Center"
                              Data="{Binding Icon.Geometry}"
                              Stroke="{DynamicResource WidgetForegroundBrush}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock x:Name="Percent"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="12"
                                   Text="{Binding PercentText}"
                                   Foreground="{DynamicResource Level.Good}" />
                        <Path Width="10" Height="16" Margin="3,0,0,0" Stretch="Uniform"
                              VerticalAlignment="Center"
                              Data="{StaticResource Icon.Charging}"
                              Fill="{DynamicResource Level.Good}"
                              Visibility="{Binding IsCharging, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Icon.IsImage}" Value="True">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconImage" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Level}" Value="{x:Static core:BatteryLevel.Low}">
                            <Setter TargetName="Percent" Property="Foreground" Value="{DynamicResource Level.Low}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static core:BatteryLevel.Critical}">
                            <Setter TargetName="Percent" Property="Foreground" Value="{DynamicResource Level.Critical}" />
                            <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Level.Critical}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static core:BatteryLevel.Unknown}">
                            <Setter TargetName="Percent" Property="Foreground" Value="{DynamicResource Level.Unknown}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
