<Window x:Class="BatTray.App.Panel.DetailPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panel="clr-namespace:BatTray.App.Panel"
        xmlns:loc="clr-namespace:BatTray.App.Localization"
        xmlns:models="clr-namespace:BatTray.Core.Models;assembly=BatTray.Core"
        xmlns:core="clr-namespace:BatTray.Core;assembly=BatTray.Core"
        Title="BatTray"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <!-- Margin leaves room for the drop shadow. -->
    <Border Margin="12" CornerRadius="8" Padding="16,14"
            Background="{DynamicResource Panel.Background}"
            BorderBrush="{DynamicResource Panel.Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
        </Border.Effect>

        <StackPanel Width="320">
            <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" FontSize="11"
                           Foreground="{DynamicResource Panel.Secondary}" Text="{x:Static loc:L.Tagline}" />
                <TextBlock Text="BatTray" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Panel.Text}" />
            </DockPanel>

            <TextBlock x:Name="EmptyText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4"
                       Foreground="{DynamicResource Panel.Secondary}"
                       Text="{x:Static loc:L.PanelEmpty}" />

            <ItemsControl x:Name="Items">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type panel:DetailPanelItem}">
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Image x:Name="IconImage" Grid.RowSpan="2" Width="16" Height="16" Visibility="Collapsed"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Source="{Binding Icon.Image}" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Path x:Name="Icon" Grid.RowSpan="2" Width="16" Height="16" Stretch="None"
                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                  Data="{Binding Icon.Geometry}"
                                  Stroke="{DynamicResource Panel.Text}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />

                            <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Panel.Text}" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                                <Path Width="8" Height="13" Margin="0,0,4,0" Stretch="Uniform" VerticalAlignment="Center"
                                      Data="{StaticResource Icon.Charging}" Fill="{DynamicResource Panel.Level.Good}"
                                      Visibility="{Binding IsCharging, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock x:Name="Percent" Text="{Binding PercentText}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Panel.Level.Good}" />
                            </StackPanel>

                            <!-- Level bar -->
                            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="4" Margin="0,5,0,0">
                                <Border CornerRadius="2" Background="{DynamicResource Panel.Track}" />
                                <Border x:Name="Bar" CornerRadius="2" HorizontalAlignment="Left"
                                        Background="{DynamicResource Panel.Level.Good}">
                                    <Border.Width>
                                        <MultiBinding Converter="{x:Static panel:FractionWidthConverter.Instance}">
                                            <Binding Path="Fraction" />
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,0,0"
                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Panel.Secondary}" Text="{Binding Details}" />
                        </Grid>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Icon.IsImage}" Value="True">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="IconImage" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Level}" Value="{x:Static core:BatteryLevel.Low}">
                                <Setter TargetName="Percent" Property="Foreground" Value="{DynamicResource Panel.Level.Low}" />
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Panel.Level.Low}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="{x:Static core:BatteryLevel.Critical}">
                                <Setter TargetName="Percent" Property="Foreground" Value="{DynamicResource Panel.Level.Critical}" />
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Panel.Level.Critical}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="{x:Static core:BatteryLevel.Unknown}">
                                <Setter TargetName="Percent" Property="Foreground" Value="{DynamicResource Panel.Level.Unknown}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter TargetName="NameText" Property="Opacity" Value="0.6" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
