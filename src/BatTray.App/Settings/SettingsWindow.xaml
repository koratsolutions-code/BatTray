<Window x:Class="BatTray.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ThemedWindow}"
        Icon="/Assets/BatTray.ico"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">

    <DockPanel Width="520">
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Button x:Name="CloseButton" HorizontalAlignment="Right" MinWidth="90" IsCancel="True" IsDefault="True" Click="OnClose" />
        </Border>

        <TabControl x:Name="Tabs" Margin="14,14,14,12">
            <!-- ===== Battery ===== -->
            <TabItem x:Name="BatteryTab">
                <StackPanel Margin="16,14,16,16">
                    <TextBlock x:Name="LevelsTitle" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LowLabel" VerticalAlignment="Center" Margin="0,4" />
                        <Slider x:Name="LowSlider" Grid.Column="1" Minimum="5" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="OnLowChanged" />
                        <TextBlock x:Name="LowValue" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Panel.Level.Low}" />
                        <TextBlock x:Name="CriticalLabel" Grid.Row="1" VerticalAlignment="Center" Margin="0,4" />
                        <Slider x:Name="CriticalSlider" Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="40" TickFrequency="5" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="OnCriticalChanged" />
                        <TextBlock x:Name="CriticalValue" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Panel.Level.Critical}" />
                    </Grid>

                    <TextBlock x:Name="AlertsTitle" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                    <CheckBox x:Name="AlertsBox" Click="OnAlertsClick" />
                    <CheckBox x:Name="FullChargeBox" Margin="0,10,0,0" Click="OnFullChargeClick" />
                    <TextBlock x:Name="PerDeviceHint" Style="{StaticResource Muted}" Margin="0,8,0,0" />

                    <TextBlock x:Name="HistoryTitle" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                    <CheckBox x:Name="HistoryBox" Click="OnHistoryClick" />
                    <TextBlock x:Name="HistoryHint" Style="{StaticResource Muted}" Margin="27,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="27,8,0,0">
                        <Button x:Name="ClearHistoryButton" Click="OnClearHistory" />
                        <TextBlock x:Name="HistoryStatus" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ===== Taskbar ===== -->
            <TabItem x:Name="TaskbarTab">
                <StackPanel Margin="16,14,16,16">
                    <TextBlock x:Name="PercentTitle" Style="{StaticResource SectionTitle}" />
                    <RadioButton x:Name="PercentAlways" GroupName="Percent" Tag="always" Margin="0,0,0,8" Checked="OnPercentChecked" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="PercentLow" GroupName="Percent" Tag="low" Margin="0" VerticalAlignment="Center" Checked="OnPercentChecked" />
                        <Slider x:Name="PercentBelowSlider" Width="150" Margin="10,0,0,0" Minimum="10" Maximum="90" TickFrequency="5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnPercentBelowChanged" />
                        <TextBlock x:Name="PercentBelowValue" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <RadioButton x:Name="PercentNever" GroupName="Percent" Tag="never" Checked="OnPercentChecked" />
                    <TextBlock x:Name="PercentNeverHint" Style="{StaticResource Muted}" Margin="20,2,0,0" />

                    <TextBlock x:Name="SizeTitle" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SizeSmall" GroupName="Size" Tag="small" Checked="OnSizeChecked" />
                        <RadioButton x:Name="SizeNormal" GroupName="Size" Tag="normal" Checked="OnSizeChecked" />
                        <RadioButton x:Name="SizeLarge" GroupName="Size" Tag="large" Checked="OnSizeChecked" />
                    </StackPanel>
                    <TextBlock x:Name="SizeHint" Style="{StaticResource Muted}" Margin="0,4,0,0" />

                    <TextBlock x:Name="DevicesTitle" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                    <Button x:Name="CustomizeButton" HorizontalAlignment="Left" Click="OnCustomize" />
                    <CheckBox x:Name="AllTaskbarsBox" Margin="0,12,0,0" Click="OnAllTaskbarsClick" />
                    <TextBlock x:Name="RestartHint" Style="{StaticResource Muted}" Margin="27,2,0,0" />
                </StackPanel>
            </TabItem>

            <!-- ===== General ===== -->
            <TabItem x:Name="GeneralTab">
                <StackPanel Margin="16,14,16,16">
                    <TextBlock x:Name="LanguageLabel" Margin="0,0,0,5" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="LangAuto" GroupName="Lang" Tag="auto" Checked="OnLanguageChecked" />
                        <RadioButton x:Name="LangEn" GroupName="Lang" Tag="en" Content="English" Checked="OnLanguageChecked" />
                        <RadioButton x:Name="LangEs" GroupName="Lang" Tag="es" Content="Español" Checked="OnLanguageChecked" />
                    </StackPanel>
                    <TextBlock x:Name="ThemeLabel" Margin="0,0,0,5" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeAuto" GroupName="Theme" Tag="auto" Checked="OnThemeChecked" />
                        <RadioButton x:Name="ThemeLight" GroupName="Theme" Tag="light" Checked="OnThemeChecked" />
                        <RadioButton x:Name="ThemeDark" GroupName="Theme" Tag="dark" Checked="OnThemeChecked" />
                    </StackPanel>

                    <CheckBox x:Name="StartBox" Margin="0,18,0,0" Click="OnStartClick" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox x:Name="HotkeyBox" VerticalAlignment="Center" Click="OnHotkeyClick" />
                        <TextBox x:Name="HotkeyText" Width="130" Margin="8,0,0,0" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 VerticalAlignment="Center" HorizontalContentAlignment="Center" Cursor="Hand"
                                 PreviewKeyDown="OnHotkeyKeyDown" GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Muted}" Margin="27,2,0,0" />
                    <TextBlock x:Name="HotkeyError" Margin="27,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource App.Danger}" Visibility="Collapsed" />

                    <CheckBox x:Name="UpdatesBox" Margin="0,12,0,0" Click="OnUpdatesClick" />
                    <TextBlock x:Name="UpdatesHint" Style="{StaticResource Muted}" Margin="27,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="27,8,0,0">
                        <Button x:Name="CheckNowButton" Click="OnCheckNow" />
                        <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="300" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="DiagnosticsButton" Click="OnDiagnostics" />
                        <Button x:Name="LogsButton" Margin="8,0,0,0" Click="OnLogs" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
