<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>BatTray.App</RootNamespace>
    <AssemblyName>BatTray</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BatTray.ico</ApplicationIcon>
    <Description>Battery levels of your wireless peripherals, right on the Windows taskbar.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatTray.Core\BatTray.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\BatTray.ico" />
    <None Include="Assets\BatTray-512.png" />
  </ItemGroup>

</Project>
