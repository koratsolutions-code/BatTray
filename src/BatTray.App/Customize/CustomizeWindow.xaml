<Window x:Class="BatTray.App.Customize.CustomizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize devices"
        Icon="/Assets/BatTray.ico"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="#FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="#16284C">

    <Window.Resources>
        <!-- Icon tile: a toggle with the icon drawn in the brand navy. -->
        <Style x:Key="IconTile" TargetType="RadioButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" CornerRadius="6" BorderThickness="1.5" BorderBrush="#D5DEEA" Background="#FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#F0F5FD" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2E6FD0" />
                                <Setter TargetName="Box" Property="Background" Value="#E8F0FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F5F8FC" BorderBrush="#E3E9F2" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" MinWidth="84" Padding="12,5" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
                <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="Save" MinWidth="84" Padding="12,5" IsDefault="True" Click="OnSave" />
                <Button x:Name="ResetButton" Content="Reset to default" Padding="12,5" HorizontalAlignment="Left" Click="OnReset" />
            </DockPanel>
        </Border>

        <!-- Device list -->
        <Border DockPanel.Dock="Left" Width="220" BorderBrush="#E3E9F2" BorderThickness="0,0,1,0">
            <ListBox x:Name="DeviceList" BorderThickness="0" Padding="6" SelectionChanged="OnDeviceSelected"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2,5">
                            <ContentPresenter Content="{Binding IconElement}" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DisplayName}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="160" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Editor -->
        <StackPanel x:Name="Editor" Width="420" Margin="22,18,22,16">
            <TextBlock Text="Name" />
            <TextBox x:Name="NameBox" Padding="4,3" Margin="0,4,0,0" MaxLength="60" />
            <TextBlock x:Name="OriginalName" FontSize="11" Foreground="#5A6B85" Margin="0,4,0,0" />

            <TextBlock Text="Icon" Margin="0,16,0,6" />
            <WrapPanel x:Name="IconPanel" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Upload image…" Padding="12,5" Click="OnUpload" />
                <TextBlock FontSize="11" Foreground="#5A6B85" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280"
                           Text="PNG, JPG, BMP, GIF or ICO. It is resized to 64×64; square images look best." />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Margin="0,10,0,0" Foreground="#C42B1C" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </DockPanel>
</Window>
