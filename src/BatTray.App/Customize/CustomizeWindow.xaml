<Window x:Class="BatTray.App.Customize.CustomizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BatTray.App.Localization"
        Style="{StaticResource ThemedWindow}"
        Title="{x:Static loc:L.CustomizeTitle}"
        Icon="/Assets/BatTray.ico"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Icon tile: a toggle with the icon drawn in the theme's text colour. -->
        <Style x:Key="IconTile" TargetType="RadioButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" CornerRadius="6" BorderThickness="1.5"
                                BorderBrush="{DynamicResource App.InputBorder}" Background="{DynamicResource App.InputBackground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource App.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource App.AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{x:Static loc:L.Close}" MinWidth="84" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
                <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="{x:Static loc:L.Save}" MinWidth="84" IsDefault="True" Click="OnSave" />
                <Button x:Name="ResetButton" Content="{x:Static loc:L.ResetToDefault}" HorizontalAlignment="Left" Click="OnReset" />
            </DockPanel>
        </Border>

        <!-- Device list -->
        <Border DockPanel.Dock="Left" Width="230" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,1,0">
            <ListBox x:Name="DeviceList" Padding="6" SelectionChanged="OnDeviceSelected"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2,5">
                            <ContentPresenter Content="{Binding IconElement}" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DisplayName}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="170" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Editor -->
        <StackPanel x:Name="Editor" Width="420" Margin="22,18,22,16">
            <TextBlock Text="{x:Static loc:L.Name}" />
            <TextBox x:Name="NameBox" Margin="0,4,0,0" MaxLength="60" />
            <TextBlock x:Name="OriginalName" Style="{StaticResource Muted}" Margin="0,4,0,0" />

            <TextBlock Text="{x:Static loc:L.Icon}" Margin="0,16,0,6" />
            <WrapPanel x:Name="IconPanel" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{x:Static loc:L.UploadImage}" Click="OnUpload" />
                <TextBlock Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="280"
                           Text="{x:Static loc:L.UploadHint}" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Margin="0,10,0,0" Foreground="{DynamicResource App.Danger}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </DockPanel>
</Window>
