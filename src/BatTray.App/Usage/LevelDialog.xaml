<Window x:Class="BatTray.App.Usage.LevelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set battery level"
        Icon="/Assets/BatTray.ico"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        UseLayoutRounding="True"
        Background="#FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="#16284C">

    <StackPanel Width="320">
        <StackPanel Margin="24,22,24,16">
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,14,0,4" Text="Battery level (%)" />
            <TextBox x:Name="PercentBox" Padding="4,3" Width="90" HorizontalAlignment="Left" />
            <TextBlock x:Name="ErrorText" Margin="0,10,0,0" Foreground="#C42B1C" TextWrapping="Wrap" Visibility="Collapsed"
                       Text="Enter a whole number from 0 to 100." />
        </StackPanel>

        <Border Background="#F5F8FC" BorderBrush="#E3E9F2" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" MinWidth="84" Padding="12,5" IsDefault="True" Click="OnSave" />
                <Button Content="Cancel" MinWidth="84" Padding="12,5" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
