<Window x:Class="BatTray.App.Usage.EstimateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BatTray.App.Localization"
        Style="{StaticResource ThemedWindow}"
        Title="{x:Static loc:L.EstimateTitle}"
        Icon="/Assets/BatTray.ico"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True">

    <StackPanel Width="400">
        <StackPanel Margin="24,22,24,16">
            <TextBlock Text="{x:Static loc:L.EstimateTitle}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource App.TextSecondary}"
                       Text="{x:Static loc:L.EstimateIntro}" />

            <TextBlock Margin="0,18,0,4" Text="{x:Static loc:L.Name}" />
            <TextBox x:Name="NameBox" />

            <TextBlock Margin="0,14,0,4" Text="{x:Static loc:L.BatteryLife}" />
            <TextBox x:Name="HoursBox" Width="90" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="{x:Static loc:L.BatteryLifeHint}" />

            <TextBlock Margin="0,14,0,4" Text="{x:Static loc:L.CurrentCharge}" />
            <TextBox x:Name="PercentBox" Width="90" HorizontalAlignment="Left" Text="100" />

            <TextBlock x:Name="ErrorText" Margin="0,10,0,0" Foreground="{DynamicResource App.Danger}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <Border Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static loc:L.Save}" MinWidth="84" IsDefault="True" Click="OnSave" />
                <Button Content="{x:Static loc:L.Cancel}" MinWidth="84" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
