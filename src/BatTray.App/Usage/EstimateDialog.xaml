<Window x:Class="BatTray.App.Usage.EstimateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estimate battery from usage"
        Icon="/Assets/BatTray.ico"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        UseLayoutRounding="True"
        Background="#FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="#16284C">

    <StackPanel Width="380">
        <StackPanel Margin="24,22,24,16">
            <TextBlock Text="Estimate battery from usage" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#3A4A66"
                       Text="This device does not report its battery. BatTray will count how long you use it and show an estimate (~%)." />

            <TextBlock Margin="0,18,0,4" Text="Name" />
            <TextBox x:Name="NameBox" Padding="4,3" />

            <TextBlock Margin="0,14,0,4" Text="Battery life on a full charge (hours of use)" />
            <TextBox x:Name="HoursBox" Padding="4,3" Width="90" HorizontalAlignment="Left" />
            <TextBlock FontSize="11" Foreground="#5A6B85" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Check the manual or the product page. You can change it later." />

            <TextBlock Margin="0,14,0,4" Text="Current charge (%)" />
            <TextBox x:Name="PercentBox" Padding="4,3" Width="90" HorizontalAlignment="Left" Text="100" />

            <TextBlock x:Name="ErrorText" Margin="0,10,0,0" Foreground="#C42B1C" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <Border Background="#F5F8FC" BorderBrush="#E3E9F2" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" MinWidth="84" Padding="12,5" IsDefault="True" Click="OnSave" />
                <Button Content="Cancel" MinWidth="84" Padding="12,5" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
